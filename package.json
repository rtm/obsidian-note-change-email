{
  "name": "obsidian-note-change-email",
  "version": "1.0.0",
  "description": "Email a smart diff of your edits when you stop editing a note tagged with a recipient.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "deploy": "node esbuild.config.mjs production && node deploy.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^16.11.6",
    "builtin-modules": "^3.3.0",
    "esbuild": "0.17.3",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5"
  }
}
